<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle
    xmlns="http://soap.sforce.com/2006/04/metadata">

    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>

    <masterLabel>Birthday Wishes</masterLabel>

    <description>
        A personalized birthday wishes website.
    </description>

    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
                name="recipientName"
                type="String"
                label="Birthday Person's Name"
                default="My Beautiful Sister"/>

            <property
                name="birthdayMessage"
                type="String"
                label="Birthday Message"
                default="Happy Birthday to someone who means the world to me!"/>

            <property
                name="videoUrl"
                type="String"
                label="Birthday Video URL"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
