<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle
    xmlns="http://soap.sforce.com/2006/04/metadata">

    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>

    <masterLabel>Configurable Welcome Banner</masterLabel>
    <description>
        A reusable welcome banner configurable in Lightning App Builder.
    </description>

    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightning__RecordPage">

            <property
                name="bannerTitle"
                type="String"
                label="Banner Heading"
                description="Enter the banner heading."
                default="Welcome to Salesforce"/>

            <property
                name="bannerMessage"
                type="String"
                label="Banner Description"
                description="Enter the banner description."
                default="Configure this component using Lightning App Builder."/>

            <property
                name="buttonLabel"
                type="String"
                label="Button Label"
                default="Get Started"/>

            <property
                name="showButton"
                type="Boolean"
                label="Show Button"
                default="true"/>

            <property
                name="showIcon"
                type="Boolean"
                label="Show Icon"
                default="true"/>

        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
