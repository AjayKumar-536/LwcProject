public with sharing class VisionzCommerceController {
 @AuraEnabled(cacheable=true) public static List<Cart_Item__c> getCart(String customerEmail){if(String.isBlank(customerEmail))return new List<Cart_Item__c>();return [SELECT Id,Name,Product__c,Product__r.Name,Quantity__c,Unit_Price__c FROM Cart_Item__c WHERE Customer_Email__c=:customerEmail ORDER BY CreatedDate DESC];}
 @AuraEnabled public static Id addToCart(Id productId,Integer quantity,String customerEmail){if(productId==null||quantity==null||quantity<1||String.isBlank(customerEmail))throw new AuraHandledException('Enter a product, positive quantity, and email.');Product__c p=[SELECT Id,Price__c,Stock_Quantity__c FROM Product__c WHERE Id=:productId LIMIT 1];if(p.Stock_Quantity__c<quantity)throw new AuraHandledException('Insufficient stock.');Cart_Item__c c=new Cart_Item__c(Product__c=p.Id,Quantity__c=quantity,Unit_Price__c=p.Price__c,Customer_Email__c=customerEmail);insert c;return c.Id;}
 @AuraEnabled(cacheable=true) public static List<Order__c> getOrders(String customerEmail){if(String.isBlank(customerEmail))return new List<Order__c>();return [SELECT Id,Name,Order_Date__c,Order_Status__c,Total_Amount__c FROM Order__c WHERE Customer_Email__c=:customerEmail ORDER BY CreatedDate DESC LIMIT 100];}
}